# Environment variables for the Collections dashboard. Copy to .env for local runs, or add each one in
# Dokploy > Environment. Never commit real values. HOST, PORT and NODE_ENV are set in the Dockerfile.

# --- Login (all three required: without them every page is blocked) ---
# Login ID for the shared dashboard account
DASHBOARD_USER=
# Password for the shared dashboard account
DASHBOARD_PASSWORD=
# Long random string (32+ characters) used to sign login session cookies
DASHBOARD_SESSION_SECRET=

# --- n8n ---
# n8n API key (reads the data tables)
N8N_API_KEY=
# Key for the contact approval webhook (workflow 28)
N8N_APPROVAL_SECRET=
# Key for the contact command, Call again and dashboard log webhooks (workflows 21, 23, 24)
N8N_CONTACT_SECRET=
# Key for the WhatsApp reminder template webhook
N8N_WA_REMINDER_KEY=
# Key for the escalation worklist update webhook (workflow 27)
N8N_WORKLIST_SECRET=

# --- AI assistant ---
# OpenAI API key for the AI assistant chat
OPENAI_API_KEY=
# Optional: OpenAI model name (a default is used when empty)
OPENAI_MODEL=

# --- Gmail (Email page) ---
# The accounting mailbox address (e.g. grace.accounting@...)
GMAIL_BUSINESS_EMAIL=
# Google OAuth client ID for Gmail
GMAIL_CLIENT_ID=
# Google OAuth client secret for Gmail
GMAIL_CLIENT_SECRET=
# Google OAuth refresh token for the accounting mailbox
GMAIL_REFRESH_TOKEN=

# --- Google Picker (attach files from Google Drive) ---
# Google API key for the Picker
GOOGLE_PICKER_API_KEY=
# Google OAuth client ID for the Picker
GOOGLE_PICKER_CLIENT_ID=
# Google Cloud project number (app ID) for the Picker
GOOGLE_PICKER_APP_ID=

# --- Telerivet (SMS and Viber) ---
# Telerivet API key
TELERIVET_API_KEY=
# Telerivet project ID
TELERIVET_PROJECT_ID=
# Telerivet phone (route) ID used for SMS
TELERIVET_SMS_PHONE_ID=

# --- Twilio (WhatsApp) ---
# Twilio account SID
TWILIO_ACCOUNT_SID=
# Twilio auth token
TWILIO_AUTH_TOKEN=
# WhatsApp sender number (e.g. whatsapp:+63...)
TWILIO_WHATSAPP_NUMBER=

# --- Vapi (Voice page) ---
# Vapi private API key
VAPI_PRIVATE_KEY=
# Optional: only list calls of this assistant (comma-separated IDs allowed)
VAPI_ASSISTANT_ID=

# --- Document Verification ---
# Base URL of the document verification engine
DV_ENGINE_URL=
# API key for the document verification engine
DV_API_KEY=

# --- Reply attachments (Supabase storage) ---
# Supabase project URL (was set in wrangler.jsonc: https://zetjnskkhgjszldijkkv.supabase.co)
SUPABASE_URL=
# Supabase service role key (server only)
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name (was set in wrangler.jsonc: reply-media)
SUPABASE_STORAGE_BUCKET=
