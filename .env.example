# Copy this file to .env for LOCAL DEVELOPMENT ONLY. .env is gitignored and
# never committed, and is never read by a deployed Cloudflare Worker.
#
# For the deployed Worker, set every one of these in the Cloudflare dashboard:
# Workers & Pages -> accounting-collection -> Settings -> Variables and Secrets.
# Mark actual secrets (API keys, tokens, client secret) as "Encrypt", not plain
# text. After adding/changing them, redeploy (push a commit, or trigger
# manually from the dashboard) for the Worker to pick them up.

# ---------------------------------------------------------------------------
# n8n (still required — Clients, Reminder Queue, Daily Run Logs, Channel
# Counters, Promise History, and Escalations all read from n8n's own
# internal tables and have no external source to bypass it with)
# ---------------------------------------------------------------------------
N8N_WEBHOOK_BASE_URL=https://rareglobalfood.app.n8n.cloud/webhook

# ---------------------------------------------------------------------------
# Gmail (Email tab — direct Gmail API, no longer proxied through n8n)
# ---------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_BUSINESS_EMAIL=prince@rareglobalfood.com

# ---------------------------------------------------------------------------
# Vapi (Voice tab — direct Vapi API, no longer proxied through n8n)
# ---------------------------------------------------------------------------
VAPI_PRIVATE_KEY=
# Optional — omit to list calls across all assistants on the account
VAPI_ASSISTANT_ID=

# ---------------------------------------------------------------------------
# Telerivet (SMS tab — direct Telerivet API, no longer proxied through n8n)
# ---------------------------------------------------------------------------
TELERIVET_API_KEY=
# Full project ID, e.g. "PJ0c188306515689f8" — not the short form
TELERIVET_PROJECT_ID=
# The Phone/Route ID for your SMS service specifically. REQUIRED if SMS and
# Viber share the same Telerivet project — otherwise both channels' messages
# get mixed into the SMS tab. Find it in Telerivet dashboard -> Phones.
TELERIVET_SMS_PHONE_ID=

# ---------------------------------------------------------------------------
# Twilio (WhatsApp tab — direct Twilio API, no longer proxied through n8n)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your WhatsApp-enabled Twilio number, in the "whatsapp:+1415XXXXXXX" format
TWILIO_WHATSAPP_NUMBER=
