{
  "name": "accounting-collection",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-01-01",
  // Required: several routes use Node's Buffer (gmail-server.ts, telerivet-server.ts,
  // vapi-call-audio.ts, gmail-attachment.ts). Without this flag those crash at runtime
  // even though the build succeeds.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
  },
  "vars": {
    "SUPABASE_URL": "https://zetjnskkhgjszldijkkv.supabase.co",
    "SUPABASE_STORAGE_BUCKET": "reply-media",
  },
  // Shared data cache for all server instances (src/lib/n8n-datatable.ts). Created 10 Nov 2026 with
  // 'npx wrangler kv namespace create DATA_CACHE'.
  "kv_namespaces": [
    {
      "binding": "DATA_CACHE",
      "id": "4da898a262a8428fa547b677932a69c1",
    },
  ],
  "triggers": {
    "crons": ["0 */6 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
