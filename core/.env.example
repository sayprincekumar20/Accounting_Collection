# Copy to .env for local work. In Dokploy these are set in the Environment tab, never committed.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://rgf:rgf@localhost:5432/rgf_core
# Shared secret the dashboard server sends as X-API-Key. Empty = every protected endpoint refuses (fail closed).
SERVICE_API_KEY=
# Only needed to run the one-time import of the n8n data tables (python -m app.tools.import_n8n).
N8N_BASE_URL=https://rareglobalfood.app.n8n.cloud
N8N_API_KEY=
N8N_WEBHOOK_BASE=https://rareglobalfood.app.n8n.cloud/webhook
# Key of the n8n webhooks used for statement PDFs while that wave is still on n8n.
N8N_CONTACT_SECRET=
