string button.dv_verify_account_button(String accId)
{
user_email = ifnull(zoho.loginuserid,"");
answer = standalone.dv_verify_account(accId,"Verify Account button",user_email,user_email,Map());
message = "The verification could not be started. Please contact the CRM admin.";
if(answer != null && answer.toString().contains("message"))
{
	message = ifnull(answer.toString().toMap().get("message"),message);
}
return message;
}
